NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS_LONG
# Production: set to the verified proxy hop count for your Hostinger deployment.
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=YOUR_DATABASE_NAME
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_SSL=false
# Optional PEM CA file for a remote database. Certificate validation stays enabled.
DB_SSL_CA_FILE=

# Phase 7: keep off until Gmail test delivery is verified.
MAIL_MODE=off
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
MAIL_FROM=YOUR_GMAIL_ADDRESS
MAIL_TEST_RECIPIENT=YOUR_TEST_ADDRESS
